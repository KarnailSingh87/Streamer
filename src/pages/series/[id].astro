---
// src/pages/series/[id].astro — 1:1 NetMirror Series Detail & Player Page
import Layout from '../../layouts/Layout.astro';
import WatchNow from '../../components/WatchNow.astro';
import { getSeriesFull, getOfficialTrailerKey, getSeasonDetails } from '../../lib/tmdb';
import type { TMDBSeason } from '../../lib/types';
import '../../styles/netmirror-detail.css';

const { id } = Astro.params;

if (!id || isNaN(parseInt(id))) {
  return Astro.redirect('/series');
}

const reqSeason = Astro.url.searchParams.get('season');
const reqEpisode = Astro.url.searchParams.get('episode');
const isAutoPlay = Astro.url.searchParams.get('play') === '1';

const initialSeason = reqSeason && /^\d+$/.test(reqSeason) ? parseInt(reqSeason, 10) : undefined;
const initialEpisode = reqEpisode && /^\d+$/.test(reqEpisode) ? parseInt(reqEpisode, 10) : undefined;

let data: Awaited<ReturnType<typeof getSeriesFull>> | null = null;
let error: string | null = null;
let notFound = false;

try {
  data = await getSeriesFull(id);
} catch (e) {
  const msg = e instanceof Error ? e.message : '';
  if (msg.includes('404')) notFound = true;
  else error = msg || 'Failed to load series';
}

if (notFound) {
  return Astro.redirect('/series');
}

if (!data) {
  error = error || 'Failed to load series';
}

const series = data?.series;
const credits = data?.credits;
const videos = data?.videos;
const trailerKey = videos ? getOfficialTrailerKey(videos) : null;
const recommendations = data?.recommendations?.results.slice(0, 12) ?? [];

const TMDB_IMG = 'https://image.tmdb.org/t/p';
const backdropUrl = series?.backdrop_path ? `${TMDB_IMG}/w1280${series.backdrop_path}` : null;
const posterUrl = series?.poster_path ? `${TMDB_IMG}/w500${series.poster_path}` : null;

const releaseYear = series?.first_air_date?.slice(0, 4) || '2024';
const rating = series?.vote_average ? Math.round(series.vote_average * 10) / 10 : null;
const vote = series?.vote_average || 7.2;
const matchScore = Math.min(99, Math.max(68, Math.round(vote * 10 + 14)));
const ageRating = vote >= 7.8 ? 'U/A 16+' : 'U/A 13+';

const mainSeasons = (series?.seasons ?? []).filter((s: TMDBSeason) => s.season_number > 0);
const seasonsWithEpisodes = mainSeasons.filter((s: TMDBSeason) => (s.episode_count ?? 0) > 0);
const seasonSource: TMDBSeason[] =
  seasonsWithEpisodes.length > 0 ? seasonsWithEpisodes : mainSeasons;

const playerSeasons =
  seasonSource.length > 0
    ? seasonSource.map((s: TMDBSeason) => ({
        season_number: s.season_number,
        name: s.name,
        episode_count: s.episode_count,
      }))
    : [{ season_number: 1, name: 'Season 1', episode_count: series?.number_of_episodes ?? 0 }];

const initialSeasonNum = initialSeason || (mainSeasons[0]?.season_number ?? 1);

// Fetch Season 1 episodes server-side for instant load
let episodes: Array<{
  episode_number: number;
  name: string;
  overview: string;
  still_path: string | null;
  runtime: number | null;
}> = [];

try {
  const sData = await getSeasonDetails(id, initialSeasonNum);
  episodes = sData.episodes ?? [];
} catch {}

const creatorNames = (series?.created_by || []).map((c: any) => c.name).join(', ');
const castNames = (credits?.cast || []).slice(0, 8).map((c: any) => c.name).join(', ');
const genreNames = (series?.genres || []).map((g: any) => g.name).join(', ');
const spokenLangs = (series?.spoken_languages || []).map((l: any) => l.english_name || l.name).filter(Boolean);
const activeLang = spokenLangs.includes('Hindi') ? 'Hindi' : (spokenLangs[0] || 'English');

const relatedForPlayer = recommendations.slice(0, 6).map((item) => ({
  id: item.id,
  title: item.name ?? '',
  posterUrl: item.poster_path ? `${TMDB_IMG}/w185${item.poster_path}` : null,
  href: `/series/${item.id}`,
}));
---

<Layout
  title={series ? `${series.name}${releaseYear ? ` (${releaseYear})` : ''} — NetMirror` : 'Series'}
  description={series?.overview || series?.tagline || 'Series details'}
  image={backdropUrl ?? posterUrl}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://autoembed.co" crossorigin />
    <link rel="dns-prefetch" href="https://autoembed.co" />
    <link rel="dns-prefetch" href="https://vidsrc.pm" />
    <link rel="dns-prefetch" href="https://www.2embed.cc" />
    <link rel="dns-prefetch" href="https://vidlink.pro" />
    <link rel="dns-prefetch" href="https://vidfast.vc" />
  </Fragment>

  {error || !series ? (
    <div class="detail-error container" style="padding: 6rem 1rem; text-align: center;">
      <h1>Failed to load</h1>
      <p>{error}</p>
      <a href="/series" class="netmirror-btn-play" style="display: inline-block; margin-top: 1rem;">Back to Series</a>
    </div>
  ) : (
    <div class="netmirror-page-wrap">
      {/* Background Poster Blur */}
      <div class="netmirror-page-backdrop" style={`background-image: url(${backdropUrl ?? posterUrl});`}></div>
      <div class="netmirror-backdrop-overlay"></div>

      {/* ── NetMirror 1:1 Card Modal Container ── */}
      <article class="netmirror-card">
        {/* Top Hero: Billboard Backdrop Hero */}
        <div class="netmirror-card-hero">
          <img
            src={backdropUrl ?? posterUrl}
            alt={series.name}
            class="netmirror-card-hero-img"
          />
          <div class="netmirror-card-hero-gradient"></div>

          <a href="/" class="netmirror-card-close" aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </a>

          <div class="netmirror-card-hero-content">
            <h1 class="netmirror-card-title">{series.name}</h1>
            <div class="netmirror-card-hero-actions">
              <a href={`/series/${series.id}?play=1#watch`} class="netmirror-btn-play" id="nm-series-play-btn">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3" />
                </svg>
                <span>Play</span>
              </a>

                <button
                  type="button"
                  class="netmirror-btn-circle"
                  id="nm-wl-toggle"
                  data-id={series.id}
                  data-type="tv"
                  data-title={series.name}
                  data-poster={posterUrl}
                  title="Add to My List"
                  aria-label="Add to My List"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>

                <button
                  type="button"
                  class="netmirror-btn-circle"
                  id="nm-like-toggle"
                  title="I like this"
                  aria-label="Like"
                >
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                  </svg>
                </button>

                <span class="netmirror-badge-recent">Recently added</span>
              </div>
            </div>
          </div>

        {/* ── Metadata 2-Columns ── */}
        <div class="netmirror-card-body">
          <div class="netmirror-meta-grid">
            {/* Left Column */}
            <div class="netmirror-meta-left">
              <div class="netmirror-badge-row">
                <span class="netmirror-score">{matchScore}% match</span>
                <span class="netmirror-year">{releaseYear}</span>
                <span class="netmirror-seasons">
                  {series.number_of_seasons || 1} Season{(series.number_of_seasons || 1) > 1 ? 's' : ''}
                </span>
                <span class="netmirror-hd-pill">HD</span>
              </div>

              <div class="netmirror-rating-line">
                <span class="netmirror-age-box">{ageRating}</span>
                <span class="netmirror-descriptors">sexual content, substances, language</span>
              </div>

              <p class="netmirror-desc">{series.overview}</p>

              {spokenLangs.length > 0 && (
                <div class="netmirror-lang-tabs">
                  {['Unknown', ...spokenLangs.slice(0, 5)].map((lang, idx) => (
                    <button
                      type="button"
                      class={`netmirror-lang-item ${lang === activeLang || (idx === 1 && !spokenLangs.includes(activeLang)) ? 'is-active' : ''}`}
                    >
                      {lang}
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Right Column */}
            <div class="netmirror-meta-right">
              {castNames && (
                <div class="netmirror-info-row">
                  <span class="nm-lbl">Cast: </span>
                  <span class="nm-txt">{castNames}</span>
                </div>
              )}
              {genreNames && (
                <div class="netmirror-info-row">
                  <span class="nm-lbl">Genres: </span>
                  <span class="nm-txt">{genreNames}</span>
                </div>
              )}
              <div class="netmirror-info-row">
                <span class="nm-lbl">This show is: </span>
                <span class="nm-txt">Sentimental, Understated, Drama, Enduring Love, Bollywood, TV</span>
              </div>
            </div>
          </div>

          {/* ── Episodes Section ── */}
          <div class="netmirror-episodes">
            <div class="netmirror-episodes-head">
              <h2 class="netmirror-title">Episodes</h2>
              {mainSeasons.length > 1 && (
                <div class="netmirror-select-wrap">
                  <select id="season-selector" class="netmirror-season-dropdown" data-series-id={series.id}>
                    {mainSeasons.map((s) => (
                      <option value={s.season_number} selected={s.season_number === initialSeasonNum}>
                        Season {s.season_number} ({s.episode_count} EP)
                      </option>
                    ))}
                  </select>
                  <span class="nm-arrow">▼</span>
                </div>
              )}
            </div>

            <div class="netmirror-ep-list" id="episodes-container">
              {episodes.map((ep) => {
                const epThumb = ep.still_path ? `${TMDB_IMG}/w300${ep.still_path}` : null;
                const epRuntime = ep.runtime ? `${ep.runtime}m` : '30m';
                const epPlayHref = `/series/${series.id}?season=${initialSeasonNum}&episode=${ep.episode_number}&play=1#watch`;
                const isActive = isAutoPlay && ep.episode_number === (initialEpisode || 1);
                return (
                  <a href={epPlayHref} class={`netmirror-ep-row ${isActive ? 'is-active' : ''}`} data-season={initialSeasonNum} data-episode={ep.episode_number}>
                    <span class="netmirror-ep-idx">{ep.episode_number}</span>
                    <div class="netmirror-ep-thumb-box">
                      {epThumb ? (
                        <img src={epThumb} alt={ep.name} class="netmirror-ep-thumb-img" loading="lazy" />
                      ) : (
                        <div class="nm-ep-placeholder"></div>
                      )}
                      <div class="netmirror-ep-play-circle">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                          <polygon points="6 4 20 12 6 20 6 4" />
                        </svg>
                      </div>
                    </div>
                    <div class="netmirror-ep-details">
                      <div class="netmirror-ep-row-top">
                        <h3 class="netmirror-ep-name">{ep.name}</h3>
                        <span class="netmirror-ep-time">{epRuntime}</span>
                      </div>
                      <p class="netmirror-ep-synopsis">{ep.overview || series.overview}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>

          {/* ── More Like This Section ── */}
          {recommendations.length > 0 && (
            <div class="netmirror-more-like-this">
              <h2 class="netmirror-title">More Like This</h2>
              <div class="netmirror-cards-grid">
                {recommendations.slice(0, 9).map((rec) => {
                  const recImg = rec.backdrop_path
                    ? `${TMDB_IMG}/w780${rec.backdrop_path}`
                    : (rec.poster_path ? `${TMDB_IMG}/w500${rec.poster_path}` : null);
                  const recYear = rec.first_air_date ? rec.first_air_date.slice(0, 4) : '2025';
                  const recScore = Math.min(98, Math.max(50, Math.round((rec.vote_average || 6.5) * 10 + 10)));
                  const recHref = `/series/${rec.id}`;
                  return (
                    <div class="netmirror-mini-card">
                      <div class="netmirror-mini-thumb">
                        {recImg && <img src={recImg} alt={rec.name} loading="lazy" />}
                        <span class="netmirror-mini-badge">1 Season</span>
                        <span class="netmirror-mini-red">Recently added</span>
                        <a
                          href={recHref}
                          class="netmirror-mini-play-overlay"
                          aria-label={`View ${rec.name}`}
                          onclick={`window.dispatchEvent(new CustomEvent('open-netmirror-modal', { detail: { id: ${rec.id}, mediaType: 'tv' } })); return false;`}
                        >
                          <div class="netmirror-play-circle-sm">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                              <polygon points="6 4 20 12 6 20 6 4" />
                            </svg>
                          </div>
                        </a>
                      </div>
                      <div class="netmirror-mini-info">
                        <div class="netmirror-mini-meta">
                          <div class="nm-tags">
                            <span class="nm-green">{recScore}% match</span>
                            <span class="nm-age">U/A 16+</span>
                            <span class="nm-year">{recYear}</span>
                          </div>
                          <button type="button" class="nm-add-btn" aria-label="Add to List">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                              <line x1="12" y1="5" x2="12" y2="19"></line>
                              <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                          </button>
                        </div>
                        <p class="netmirror-mini-desc">{rec.overview}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* ── About Section ── */}
          <div class="netmirror-about-section">
            <h2 class="netmirror-title">About {series.name}</h2>
            <div class="netmirror-about-grid">
              {creatorNames && (
                <div class="nm-about-item">
                  <span class="nm-lbl">Creator: </span>
                  <span class="nm-txt">{creatorNames}</span>
                </div>
              )}
              {castNames && (
                <div class="nm-about-item">
                  <span class="nm-lbl">Cast: </span>
                  <span class="nm-txt">{castNames}</span>
                </div>
              )}
              {genreNames && (
                <div class="nm-about-item">
                  <span class="nm-lbl">Genres: </span>
                  <span class="nm-txt">{genreNames}</span>
                </div>
              )}
              <div class="nm-about-item">
                <span class="nm-lbl">This show is: </span>
                <span class="nm-txt">Sentimental, Understated, Drama, Enduring Love, Bollywood, TV</span>
              </div>
              <div class="nm-about-item">
                <span class="nm-lbl">Maturity rating: </span>
                <span class="netmirror-age-box">{ageRating}</span>
                <span class="nm-txt" style="margin-left: 0.5rem;">
                  Suitable for persons aged 13 and above and under parental guidance for people under age of 14
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>

      {/* Full-Screen OTT Player Portal Container */}
      <div id="watch">
        <WatchNow
          hideTitle={true}
          mediaType="tv"
          id={series.id}
          title={series.name}
          backdropUrl={backdropUrl ?? posterUrl}
          posterUrl={posterUrl}
          seasons={playerSeasons}
          trailerKey={trailerKey}
          related={relatedForPlayer}
          genres={(series.genres ?? []).map((g) => g.name)}
          rating={rating}
          initialSeason={initialSeason}
          initialEpisode={initialEpisode}
          autoStart={isAutoPlay}
        />
      </div>
    </div>
  )}

  <script is:inline>
    // Play button and episode row direct click handling
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('nm-series-play-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('streamer:play'));
      });

      document.body.addEventListener('click', (e) => {
        const epRow = e.target.closest('.netmirror-ep-row');
        if (epRow) {
          const season = epRow.getAttribute('data-season');
          const episode = epRow.getAttribute('data-episode');
          if (season && episode) {
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('streamer:play', {
              detail: { season: Number(season), episode: Number(episode) }
            }));
          }
        }
      });
    });

    // Client-side season switcher
    (function () {
      const select = document.getElementById('season-selector');
      const container = document.getElementById('episodes-container');
      if (!select || !container) return;

      select.addEventListener('change', async (e) => {
        const seasonNum = e.target.value;
        const seriesId = select.getAttribute('data-series-id');
        container.innerHTML = '<div style="padding: 2rem; text-align: center; color: #a3a3a3;">Loading episodes...</div>';

        try {
          const res = await fetch(`/api/tv/${seriesId}/season/${seasonNum}`);
          const json = await res.json();
          if (json.episodes && json.episodes.length > 0) {
            container.innerHTML = json.episodes.map((ep) => `
              <a href="/series/${seriesId}?season=${seasonNum}&episode=${ep.episode_number}&play=1#watch" class="netmirror-ep-row" data-season="${seasonNum}" data-episode="${ep.episode_number}">
                <span class="netmirror-ep-idx">${ep.episode_number}</span>
                <div class="netmirror-ep-thumb-box">
                  ${ep.still_path ? `<img src="${ep.still_path}" alt="${ep.name}" class="netmirror-ep-thumb-img" loading="lazy" />` : '<div class="nm-ep-placeholder"></div>'}
                  <div class="netmirror-ep-play-circle">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 4 20 12 6 20 6 4" />
                    </svg>
                  </div>
                </div>
                <div class="netmirror-ep-details">
                  <div class="netmirror-ep-row-top">
                    <h3 class="netmirror-ep-name">${ep.name}</h3>
                    <span class="netmirror-ep-time">${ep.runtime}</span>
                  </div>
                  <p class="netmirror-ep-synopsis">${ep.overview || ''}</p>
                </div>
              </a>
            `).join('');
          } else {
            container.innerHTML = '<div style="padding: 2rem; text-align: center; color: #a3a3a3;">No episodes available.</div>';
          }
        } catch {
          container.innerHTML = '<div style="padding: 2rem; text-align: center; color: #e50914;">Failed to load season episodes.</div>';
        }
      });
    })();
  </script>
</Layout>
