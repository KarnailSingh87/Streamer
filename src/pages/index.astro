---
// src/pages/index.astro — Home page
import Layout from '../layouts/Layout.astro';
import MovieRail from '../components/MovieRail.astro';
import Top10Rail from '../components/Top10Rail.astro';
import HeroCarousel from '../components/react/HeroCarousel';
import ContinueWatchingRail from '../components/react/ContinueWatchingRail';
import MoodMatch from '../components/react/MoodMatch';
import TestimonialsEditorial from '../components/ui/editorial-testimonial';
import CinematicGallery from '../components/CinematicGallery.astro';
import FeaturedGallery from '../components/react/FeaturedGallery';
import { getHomePageData, getAllPlatformTop10 } from '../lib/tmdb';

let data: Awaited<ReturnType<typeof getHomePageData>> | null = null;
let platformTop10: Awaited<ReturnType<typeof getAllPlatformTop10>> | null = null;
let error: string | null = null;

try {
  [data, platformTop10] = await Promise.all([
    getHomePageData(),
    getAllPlatformTop10(),
  ]);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load content';
}

const take = (arr: any[] | undefined, n = 20): any[] => (arr ?? []).slice(0, n);

const heroAll      = data?.heroAll ?? [];
const trending     = take(data?.trending.results, 20);
const nowPlaying   = take(data?.nowPlaying.results, 20);
const onAir        = take(data?.onAir.results, 20);
const topRated     = take(data?.topRatedMovies.results, 20);
const recommended  = take(data?.popularMovies.results, 20);
const recentlyAdded= take(data?.upcoming.results, 20);

const netflixTop10 = platformTop10?.netflixTop10 ?? [];
const primeTop10   = platformTop10?.primeTop10   ?? [];
const hotstarTop10 = platformTop10?.hotstarTop10 ?? [];
const appletvTop10 = platformTop10?.appletvTop10 ?? [];

// Landscape backdrops for the lightweight cinematic gallery.
const galleryImages: string[] = [...trending, ...netflixTop10, ...topRated, ...nowPlaying]
  .map((i: any) => i?.backdrop_path)
  .filter(Boolean)
  .slice(0, 12)
  .map((p: string) => `https://image.tmdb.org/t/p/w780${p}`);

const hasContent = heroAll.length > 0 || trending.length > 0;
---

<Layout title="Streamer — Watch Movies & Series">
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Streamer?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Streamer is a comprehensive online web streaming platform dedicated to bringing you the best in global entertainment. We offer a massive library of high-definition films, trending web series, and exclusive shows that you can stream instantly from any device.</p>" }
        },
        {
          "@type": "Question",
          "name": "Is Streamer similar to platforms like Netflix, Jio, and Hotstar?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Yes! Much like Netflix, Disney+ Hotstar, and JioCinema, Streamer provides a premium web streaming experience for on-demand entertainment. We focus on delivering a diverse catalog of movies and TV series with high-speed playback, making us a top alternative for binge-watchers.</p>" }
        },
        {
          "@type": "Question",
          "name": "What kind of films and series can I watch on Streamer?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Our extensive catalog covers every major genre. You can stream action-packed Hollywood blockbusters, Bollywood hits, critically acclaimed indie films, and binge-worthy web series. Whether you are looking for spine-chilling horror or a lighthearted romantic comedy, Streamer has something for everyone.</p>" }
        },
        {
          "@type": "Question",
          "name": "Do I need to download an app to stream content?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>No app downloads are required. Streamer is optimized for seamless online web streaming directly through your browser. You can watch your favorite films and series instantly on your desktop, laptop, tablet, or smartphone.</p>" }
        },
        {
          "@type": "Question",
          "name": "Can I watch movies and web series in HD quality?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Absolutely. We believe that great films and visually stunning series deserve top-tier picture quality. The majority of the content on Streamer is available to stream in crystal-clear 1080p Full HD and select 4K resolutions, ensuring a theater-like experience at home.</p>" }
        },
        {
          "@type": "Question",
          "name": "Does Streamer offer regional and international content?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Yes. Just like Jio and Hotstar, we understand the importance of diverse, regional content. Our platform features a wide variety of international cinema, dubbed web series, and regional films to cater to our global audience.</p>" }
        },
        {
          "@type": "Question",
          "name": "Are subtitles available while web streaming?",
          "acceptedAnswer": { "@type": "Answer", "text": "<p>Yes, we provide multi-language subtitles and closed captions (CC) for a vast majority of our films and series. You can easily toggle subtitles on or off directly within the video player while streaming.</p>" }
        }
      ]
    })}</script>
  </Fragment>

  {(error || !hasContent) && (
    <div class="home-notice container" role="status">
      <span class="home-notice-dot" aria-hidden="true"></span>
      <p class="home-notice-text">
        Live catalog is temporarily unavailable — showing featured content.
        <button class="home-notice-retry" onclick="window.location.reload()">Retry</button>
        {import.meta.env.DEV && error && (<span class="home-notice-debug"> · {error}</span>)}
      </p>
    </div>
  )}

  <>
    {/* ── Single combined hero: Top 10 Movies & Series alternating ── */}
    {heroAll.length > 0 && (
      <HeroCarousel client:load slides={heroAll} label="Top 10" />
    )}

      {/* ── Content rails ── */}
      <div class="home-sections">

        {/* ── Continue Watching (renders only when the user has saved items) ── */}
        <div data-reveal>
          <ContinueWatchingRail client:idle title="Continue Watching" />
          {/* Custom Add-on Features — AI mood + time matching (all viewports).
              client:visible rather than client:only: every client:only island in
              a page makes Astro's view-transition router reload the whole target
              page in a hidden iframe before it can swap. This component reads
              window/localStorage only inside effects, so it server-renders
              safely. */}
          <div class="mood-block">
            <MoodMatch client:visible />
          </div>
        </div>

        {trending.length > 0 && (
          <div data-reveal>
            <MovieRail title="Trending Now" viewAllHref="/movies?sort=popularity.desc" items={trending} />
          </div>
        )}

        {/* ── Netflix Top 10 ── */}
        {netflixTop10.length > 0 && (
          <div data-reveal>
            <Top10Rail title="Top 10 on Netflix Today" viewAllHref="/netflix" items={netflixTop10} mediaType="tv" accentColor="#e50914" />
          </div>
        )}

        {nowPlaying.length > 0 && (
          <div data-reveal>
            <MovieRail title="Latest Movies" viewAllHref="/movies?sort=release_date.desc" items={nowPlaying} mediaType="movie" />
          </div>
        )}

        {/* ── Prime Top 10 ── */}
        {primeTop10.length > 0 && (
          <div data-reveal>
            <Top10Rail title="Top 10 on Prime Video" viewAllHref="/prime" items={primeTop10} mediaType="tv" accentColor="#00a8e0" />
          </div>
        )}

        {onAir.length > 0 && (
          <div data-reveal>
            <MovieRail title="Latest TV Shows" viewAllHref="/series?sort=first_air_date.desc" items={onAir} mediaType="tv" />
          </div>
        )}

        {/* ── Hotstar Top 10 ── */}
        {hotstarTop10.length > 0 && (
          <div data-reveal>
            <Top10Rail title="Top 10 on Hotstar" viewAllHref="/hotstar" items={hotstarTop10} mediaType="tv" accentColor="#1f80e0" />
          </div>
        )}

        {/* ── Apple TV+ Top 10 ── */}
        {appletvTop10.length > 0 && (
          <div data-reveal>
            <Top10Rail title="Top 10 on Apple TV+" viewAllHref="/appletv" items={appletvTop10} mediaType="tv" accentColor="#ffffff" />
          </div>
        )}

        {topRated.length > 0 && (
          <div data-reveal>
            <MovieRail title="Top Rated" viewAllHref="/movies?sort=vote_average.desc" items={topRated} mediaType="movie" />
          </div>
        )}

        {recommended.length > 0 && (
          <div data-reveal>
            <MovieRail title="Popular Right Now" viewAllHref="/movies?sort=popularity.desc" items={recommended} mediaType="movie" />
          </div>
        )}

        {recentlyAdded.length > 0 && (
          <div data-reveal>
            <MovieRail title="Coming Soon" viewAllHref="/movies?sort=release_date.desc" items={recentlyAdded} mediaType="movie" />
          </div>
        )}

        {/* ── Galleries ──
             FeaturedGallery (WebGL) comes first, then the zero-JavaScript
             CinematicGallery. GalleryShowcase was removed: it was a second
             Three.js canvas showing the same demo stills.

             client:visible, not client:only: client:only made the view-transition
             router reload the whole target page in a hidden iframe on every
             navigation, and it pulled the ~870 kB three.js bundle onto the
             critical path of every page load. */}
        <FeaturedGallery client:idle images={galleryImages} />
        <CinematicGallery images={galleryImages} />

        {/* ── Testimonials — editorial carousel ── */}
        <section class="container home-editorial-block" data-reveal aria-labelledby="testimonials-heading">
          <div class="feat-head">
            <span class="feat-eyebrow">Testimonials</span>
            <h2 class="feat-title" id="testimonials-heading">Loved by movie fans everywhere</h2>
            <p class="feat-sub">What viewers say about discovering and streaming with Streamer.</p>
          </div>
          <TestimonialsEditorial client:visible variant="testimonials" />
        </section>


        {/* ── FAQ Section ── */}
        <div class="faq-block container" data-reveal>
          <div class="faq-header">
            <span class="faq-eyebrow">Got questions?</span>
            <h2 class="faq-title">Frequently Asked Questions</h2>
            <p class="faq-subtitle">Everything you need to know about Streamer streaming.</p>
          </div>

          <div class="faq-list" role="list">

            {[
              {
                q: "What is Streamer?",
                a: "Streamer is a comprehensive online web streaming platform dedicated to bringing you the best in global entertainment. We offer a massive library of high-definition films, trending web series, and exclusive shows that you can stream instantly from any device."
              },
              {
                q: "Is Streamer similar to platforms like Netflix, Jio, and Hotstar?",
                a: "Yes! Much like Netflix, Disney+ Hotstar, and JioCinema, Streamer provides a premium web streaming experience for on-demand entertainment. We focus on delivering a diverse catalog of movies and TV series with high-speed playback, making us a top alternative for binge-watchers."
              },
              {
                q: "What kind of films and series can I watch on Streamer?",
                a: "Our extensive catalog covers every major genre. You can stream action-packed Hollywood blockbusters, Bollywood hits, critically acclaimed indie films, and binge-worthy web series. Whether you are looking for spine-chilling horror or a lighthearted romantic comedy, Streamer has something for everyone."
              },
              {
                q: "Do I need to download an app to stream content?",
                a: "No app downloads are required. Streamer is optimized for seamless online web streaming directly through your browser. You can watch your favorite films and series instantly on your desktop, laptop, tablet, or smartphone."
              },
              {
                q: "Can I watch movies and web series in HD quality?",
                a: "Absolutely. We believe that great films and visually stunning series deserve top-tier picture quality. The majority of the content on Streamer is available to stream in crystal-clear 1080p Full HD and select 4K resolutions, ensuring a theater-like experience at home."
              },
              {
                q: "Does Streamer offer regional and international content?",
                a: "Yes. Just like Jio and Hotstar, we understand the importance of diverse, regional content. Our platform features a wide variety of international cinema, dubbed web series, and regional films to cater to our global audience."
              },
              {
                q: "Are subtitles available while web streaming?",
                a: "Yes, we provide multi-language subtitles and closed captions (CC) for a vast majority of our films and series. You can easily toggle subtitles on or off directly within the video player while streaming."
              }
            ].map((item, i) => (
              <details class="faq-item" role="listitem">
                <summary class="faq-q">
                  <span class="faq-q-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </span>
                </summary>
                <div class="faq-a">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}

          </div>
        </div>

      </div>
    </>
</Layout>

<style>
  /* Breathing room between the Continue Watching rail and the mood matcher —
     they share one reveal wrapper, so the .home-sections gap doesn't apply,
     and the rail itself sets margin-bottom: 0. */
  .mood-block { margin-top: 2.75rem; }
  @media (min-width: 768px) {
    .mood-block { margin-top: 3.5rem; }
  }
  @media (min-width: 1024px) {
    .mood-block { margin-top: 4.5rem; }
  }

  .home-error { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 4rem 0; }
  .home-error-inner { text-align: center; max-width: 480px; }
  .home-error-icon { color: var(--color-text-3); margin-bottom: 1.5rem; }
  .home-error-title { font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-text); margin: 0 0 0.75rem; letter-spacing: -0.02em; }
  .home-error-desc { font-size: var(--font-size-base); color: var(--color-text-2); margin: 0 0 2rem; }
  .home-error-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .home-error-debug { margin-top: 2rem; text-align: left; font-size: var(--font-size-xs); color: var(--color-error); background: var(--color-surface-2); padding: 1rem; border-radius: var(--radius-md); white-space: pre-wrap; word-break: break-all; }
  .home-empty { min-height: 50vh; display: flex; align-items: center; justify-content: center; padding: 4rem 0; }
  .home-empty-text { font-size: var(--font-size-lg); color: var(--color-text-2); text-align: center; }

  /* Slim notice shown when live TMDB data is unavailable (graceful degradation) */
  .home-notice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.75rem auto;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-accent-from) 8%, var(--color-surface));
    border: 1px solid var(--color-border);
  }
  .home-notice-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #f5c518;
    box-shadow: 0 0 0 4px rgba(245,197,24,0.18);
    flex-shrink: 0;
  }
  .home-notice-text {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-2);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .home-notice-retry {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .home-notice-retry:hover { background: var(--color-surface-2); border-color: var(--color-accent-from); }
  .home-notice-debug { color: var(--color-text-3); font-size: 0.6875rem; font-family: ui-monospace, monospace; }

  /* ── SEO Block — Netflix-style ───────────────────────── */
  .seo-block {
    padding-bottom: 0;
  }

  /* Hero */
  .seo-hero {
    text-align: center;
    padding: 4rem 0 2.5rem;
    max-width: 820px;
    margin: 0 auto;
  }
  .seo-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f5c518;
    background: rgba(245,197,24,0.1);
    border: 1px solid rgba(245,197,24,0.25);
    padding: 0.3rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }
  .seo-h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.03em;
    margin: 0 0 1.125rem;
    line-height: 1.15;
  }
  .seo-lead {
    font-size: clamp(0.9rem, 1.4vw, 1.0625rem);
    color: var(--color-text-2);
    line-height: 1.75;
    margin: 0;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Stats bar */
  /* Intro text between floating photos and stats strip */
  .seo-intro {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
  }
  .seo-intro-eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5c518;
    background: rgba(245,197,24,0.1);
    border: 1px solid rgba(245,197,24,0.25);
    padding: 0.3rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  .seo-intro-title {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0 0 0.875rem;
    line-height: 1.2;
  }
  .seo-intro-text {
    font-size: clamp(0.9rem, 1.4vw, 1.0625rem);
    color: var(--color-text-2);
    line-height: 1.7;
    margin: 0;
  }

  .seo-stats-bar {
    background: transparent;
    padding: 0.5rem 0 1.5rem;
    margin-bottom: 2.5rem;
  }
  .seo-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.875rem;
    max-width: 860px;
    margin: 0 auto;
  }
  .seo-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 1.5rem 1rem;
    border-radius: var(--radius-xl, 16px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .seo-stat:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent-from) 45%, transparent);
    box-shadow: 0 14px 36px color-mix(in srgb, var(--color-accent-from) 14%, transparent);
  }
  .seo-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 0.15rem;
    border-radius: 11px;
    color: var(--color-accent-from);
    background: color-mix(in srgb, var(--color-accent-from) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-from) 22%, transparent);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .seo-stat:hover .seo-stat-icon { transform: scale(1.08); }
  .seo-stat-num {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }
  .seo-stat-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-3);
  }
  @media (max-width: 640px) {
    .seo-stats { grid-template-columns: repeat(2, 1fr); }
    .seo-stat { padding: 1.25rem 0.75rem; }
  }

  /* Feature-sections style heading + cards */
  .feat-head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 2.75rem;
  }
  .feat-eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-from);
    background: color-mix(in srgb, var(--color-accent-from) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-from) 22%, transparent);
    padding: 0.3rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  .feat-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }
  .feat-sub {
    font-size: 0.9375rem;
    color: var(--color-text-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Bento grid (features-8 style) */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    max-width: 1080px;
    margin: 0 auto;
    padding-bottom: 0.5rem;
  }
  .bento-card {
    grid-column: span 6;
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), border-color 0.35s ease, box-shadow 0.35s ease;
  }
  /* Radial accent glow that fades in on hover */
  .bento-card::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -20%;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-from) 30%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .bento-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-accent-from) 35%, transparent);
    box-shadow: 0 20px 48px rgba(0,0,0,0.35), 0 0 0 1px color-mix(in srgb, var(--color-accent-from) 12%, transparent);
  }
  .bento-card:hover::before { opacity: 1; }
  html[data-theme="light"] .bento-card:hover {
    box-shadow: 0 20px 48px rgba(0,0,0,0.12), 0 0 0 1px color-mix(in srgb, var(--color-accent-from) 14%, transparent);
  }
  /* keep card content above the glow */
  .bento-card > * { position: relative; z-index: 1; }

  /* Tablet: 2 per row, library spans full */
  @media (min-width: 640px) and (max-width: 1023px) {
    .bento-card { grid-column: span 3; }
    .bento-card--b { grid-column: span 6; }
  }
  /* Mobile: single column, tighter padding */
  @media (max-width: 639px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .bento-card,
    .bento-card--a,
    .bento-card--b,
    .bento-card--c,
    .bento-card--d {
      grid-column: 1 / -1 !important;
      padding: 1.25rem;
    }
    .bento-stat { font-size: clamp(2.5rem, 14vw, 3.5rem) !important; }
    .bento-stat-wrap { height: 68px !important; }
    .bento-window-body { height: 72px !important; }
    .feat-head { padding: 0; margin-bottom: 1.5rem !important; }
    .feat-title { font-size: clamp(1.25rem, 6vw, 1.75rem) !important; }
  }
  /* Desktop bento: 2 + 4 / 3 + 3 */
