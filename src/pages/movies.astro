---
// src/pages/movies.astro — /movies browse page
import Layout from '../layouts/Layout.astro';
import PosterCard from '../components/PosterCard.astro';
import FilterPanel from '../components/react/FilterPanel';
import HeroCarousel from '../components/react/HeroCarousel';
import Pagination from '../components/ui/pagination';
import { discoverMovies, getMovieGenres, getTrendingMovies, buildHeroSlides } from '../lib/tmdb';
import type { TMDBMovieBase } from '../lib/types';

// Parse query params
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') ?? '1');
const sortBy = url.searchParams.get('sort') ?? 'popularity.desc';
const genresParam = url.searchParams.get('genres') ?? '';
const yearFrom = url.searchParams.get('year_from') ?? '';
const yearTo = url.searchParams.get('year_to') ?? '';
const minRating = url.searchParams.get('min_rating') ?? '';
const lang = url.searchParams.get('lang') ?? '';

let movies: TMDBMovieBase[] = [];
let totalPages = 1;
let totalResults = 0;
let genres: { id: number; name: string }[] = [];
let error: string | null = null;
let heroSlides: Awaited<ReturnType<typeof buildHeroSlides>> = [];

try {
  // Fetch grid movies + genres + top trending movies for the hero in parallel.
  // Only the grid is critical: genres (filter chips) and trending (hero) must
  // never take the whole page down if a transient network error hits them.
  const emptyList = { results: [] as TMDBMovieBase[], page: 1, total_pages: 0, total_results: 0 };
  const [moviesRes, genresRes, trendingRes] = await Promise.all([
    discoverMovies({
      page,
      sort_by: sortBy,
      with_genres: genresParam || undefined,
      'primary_release_date.gte': yearFrom ? `${yearFrom}-01-01` : undefined,
      'primary_release_date.lte': yearTo ? `${yearTo}-12-31` : undefined,
      'vote_average.gte': minRating ? parseFloat(minRating) : undefined,
      with_original_language: lang || undefined,
    }),
    getMovieGenres().catch(() => ({ genres: [] })),
    getTrendingMovies('week').catch(() => emptyList),
  ]);
  movies = moviesRes.results;
  totalPages = Math.min(moviesRes.total_pages, 500);
  totalResults = moviesRes.total_results;
  genres = genresRes.genres;

  // Build enriched hero slides (movies only, top 5).
  heroSlides = await buildHeroSlides(trendingRes.results, 'movie', 5).catch(() => []);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load movies';
}

// Pagination is handled by the Ark UI <Pagination> island (URL-driven).
const initialFilters = {
  genres: genresParam ? genresParam.split(',').map(Number) : [],
  sortBy,
  yearFrom,
  yearTo,
  minRating,
  language: lang,
};

// Landscape backdrops (relevant to this page) for the shared cinematic gallery.
const galleryImages: string[] = movies
  .map((m) => m.backdrop_path)
  .filter(Boolean)
  .slice(0, 12)
  .map((p) => `https://image.tmdb.org/t/p/w780${p}`);
---

<Layout title="Movies — Browse & Find Where to Watch" galleryImages={galleryImages}>

  {/* ── Movies-only hero carousel (Top 5 Trending Movies) ── */}
  {heroSlides.length > 0 && (
    <HeroCarousel client:load slides={heroSlides} label="Top 5 Movies" />
  )}

  <div class="container browse-page">
    <div class="browse-header">
      <h1 class="browse-title">Movies</h1>
      {!error && (
        <p class="browse-count">{totalResults.toLocaleString()} movies</p>
      )}
    </div>

    <FilterPanel
      client:idle
      genres={genres}
      initialFilters={initialFilters}
      mediaType="movie"
    />

    {error ? (
      <div class="browse-error">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p class="browse-error-msg">Failed to load movies. Please try again.</p>
        <a href="/movies" class="btn btn-secondary">Reset filters</a>
      </div>
    ) : movies.length === 0 ? (
      <div class="browse-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <h2 class="browse-empty-title">No movies found</h2>
        <p class="browse-empty-desc">Try adjusting your filters or <a href="/movies" class="browse-empty-link">clear all</a>.</p>
      </div>
    ) : (
      <>
        <div class="poster-grid" role="list" aria-label="Movies grid" data-reveal>
          {movies.map((movie) => (
            <div role="listitem">
              <PosterCard
                id={movie.id}
                title={movie.title}
                mediaType="movie"
                posterPath={movie.poster_path}
                backdropPath={movie.backdrop_path}
                releaseDate={movie.release_date}
                voteAverage={movie.vote_average}
                overview={movie.overview}
              />
            </div>
          ))}
        </div>

        <Pagination
          client:load
          totalPages={totalPages}
          page={page}
          basePath="/movies"
          search={url.search}
        />
      </>
    )}
  </div>
</Layout>

<style>
  /* No top padding on browse-page — hero carousel sits immediately below the navbar */
  .browse-page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .browse-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .browse-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: var(--letter-spacing-tight);
    margin: 0;
  }

  .browse-count {
    font-size: var(--font-size-sm);
    color: var(--color-text-3);
    margin: 0;
  }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    column-gap: 1.5rem;
    row-gap: 2rem;
  }

  /* Phones: a fixed 3-up grid (2-up on the narrowest devices) keeps every card
     the same width and the rows even — matching the search and watchlist grids.
     Equal 1fr tracks + the poster's 2/3 aspect ratio mean identical card sizes. */
  @media (max-width: 639px) {
    .poster-grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 0.75rem;
      row-gap: 1.5rem;
    }
  }
  @media (max-width: 380px) {
    .poster-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 0.75rem;
    }
  }

  @media (min-width: 640px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      column-gap: 1.75rem;
      row-gap: 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      column-gap: 2rem;
      row-gap: 2.5rem;
    }
  }

  .browse-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 4rem 0;
    text-align: center;
    color: var(--color-text-3);
  }

  .browse-error-msg { font-size: var(--font-size-base); color: var(--color-text-2); margin: 0; }

  .browse-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 5rem 0;
    text-align: center;
    color: var(--color-text-3);
  }

  .browse-empty-title { font-size: var(--font-size-xl); font-weight: 600; color: var(--color-text); margin: 0; }
  .browse-empty-desc { font-size: var(--font-size-sm); color: var(--color-text-2); margin: 0; }
  .browse-empty-link { color: var(--color-accent-from); text-decoration: none; }
  .browse-empty-link:hover { text-decoration: underline; }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .pagination-btn { display: flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; }
  .pagination-pages { display: flex; gap: 0.25rem; }

  .pagination-page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    transition: all var(--duration-fast) ease;
    border: 1px solid transparent;
  }

  .pagination-page:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }

  .pagination-page--active {
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    color: #fff;
    border-color: transparent;
    pointer-events: none;
  }
</style>
