---
// src/pages/500.astro — Server Error
import Layout from '../layouts/Layout.astro';

// Astro passes the thrown error to 500.astro in SSR mode.
interface Props { error?: unknown }
const { error } = Astro.props;
const message = import.meta.env.DEV && error instanceof Error ? error.message : null;
---

<Layout
  title="500 — Something Went Wrong"
  description="An unexpected error occurred on our end."
  noIndex={true}
>
  <div class="err-page container">
    <div class="err-inner">
      <div class="err-code" aria-hidden="true">500</div>
      <h1 class="err-title">Something went wrong on our end</h1>
      <p class="err-desc">
        We hit an unexpected error while loading this page. It's not you — it's us.
        Try again in a moment, or head back home.
      </p>
      <div class="err-actions">
        <button class="btn btn-primary" onclick="window.location.reload()">Try again</button>
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>

      {message && (
        <pre class="err-debug">{message}</pre>
      )}
    </div>
  </div>
</Layout>

<style>
  .err-page { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 4rem 0; }
  .err-inner { text-align: center; max-width: 560px; }
  .err-code {
    font-size: clamp(6rem, 22vw, 12rem); font-weight: 900; line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, #ef4444, #f59e0b);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 1rem; user-select: none;
  }
  .err-title { font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-text); letter-spacing: -0.02em; margin: 0 0 0.75rem; }
  .err-desc { font-size: var(--font-size-base); color: var(--color-text-2); line-height: 1.6; margin: 0 0 2rem; }
  .err-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .err-debug {
    margin-top: 2rem; text-align: left; font-size: var(--font-size-xs); color: var(--color-error);
    background: var(--color-surface-2); padding: 1rem; border-radius: var(--radius-md);
    white-space: pre-wrap; word-break: break-all;
  }
</style>
