---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Streamer">
  <div class="container about-page">
    <div class="about-header">
      <h1 class="about-title">About Streamer</h1>
      <p class="about-tagline">Every movie and show, one clean place to find where to watch it.</p>
    </div>

    <div class="about-body">
      <section class="about-section">
        <h2>What is Streamer?</h2>
        <p>
          Streamer is a movie and TV series <strong>discovery and tracking platform</strong>. We help you:
        </p>
        <ul>
          <li>Browse and search millions of movies and TV shows</li>
          <li>Find where to legally watch any title (Netflix, Prime Video, Hotstar, JioCinema, and more)</li>
          <li>Save titles to your personal watchlist and sync across devices</li>
          <li>Rate titles you've watched, track seasons and episodes</li>
        </ul>
        <p>
          We don't stream video. Every "Watch Now" link takes you directly to a licensed streaming service.
        </p>
      </section>

      <section class="about-section">
        <h2>Our mission</h2>
        <p>
          Streaming is fragmented across dozens of platforms. Finding where to watch something
          shouldn't require opening five different apps. Streamer aggregates legal watch-provider
          data so you can find where to watch any title in seconds.
        </p>
      </section>

      <section class="about-section">
        <h2>Technology</h2>
        <p>
          Streamer is built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro 5</a>,
          Tailwind CSS v4, and React islands. It's designed for performance — near-zero JavaScript on
          browse pages means fast loads and great Core Web Vitals scores.
        </p>
        <p>
          Movie and TV data is provided by <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">The Movie Database (TMDB)</a>.
          Watch provider data is sourced from JustWatch via TMDB.
        </p>
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" class="tmdb-link" aria-label="Powered by TMDB">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 190.24 81.52" width="90" height="39" aria-hidden="true">
            <defs><linearGradient id="a-tmdb" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#90cea1"/><stop offset="100%" stop-color="#01b4e4"/></linearGradient></defs>
            <rect width="190.24" height="81.52" rx="10" fill="url(#a-tmdb)"/>
            <text x="50%" y="52%" dominant-baseline="middle" text-anchor="middle" font-family="Arial Black,sans-serif" font-weight="900" font-size="26" fill="#0d253f" letter-spacing="2">TMDB</text>
          </svg>
        </a>
        <p class="tmdb-note">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
      </section>

      <section class="about-section">
        <h2>Contact</h2>
        <p>Reach us at <a href="mailto:hello@streamer.com">hello@streamer.com</a>.</p>
      </section>
    </div>
  </div>
</Layout>

<style>
  .about-page { padding-top: calc(var(--nav-offset) + 2rem); padding-bottom: 5rem; max-width: 800px; }
  .about-header { margin-bottom: 3rem; padding-bottom: 2rem; }
  .about-title { font-size: var(--font-size-3xl); font-weight: 700; color: var(--color-text); letter-spacing: var(--letter-spacing-tight); margin: 0 0 0.75rem; }
  .about-tagline { font-size: var(--font-size-lg); color: var(--color-text-2); margin: 0; font-style: italic; }
  .about-body { display: flex; flex-direction: column; }
  .about-section { padding: 2rem 0; }
  .about-section h2 { font-size: var(--font-size-xl); font-weight: 600; color: var(--color-text); margin: 0 0 1rem; letter-spacing: var(--letter-spacing-tight); }
  .about-section p { font-size: var(--font-size-sm); color: var(--color-text-2); line-height: var(--line-height-loose); margin: 0 0 1rem; }
  .about-section ul { margin: 0 0 1rem; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .about-section li { font-size: var(--font-size-sm); color: var(--color-text-2); line-height: var(--line-height-normal); }
  .about-section a { color: var(--color-accent-from); text-decoration: none; }
  .about-section a:hover { text-decoration: underline; }
  .tmdb-link { display: inline-block; margin: 0.75rem 0 0.5rem; opacity: 0.85; }
  .tmdb-link:hover { opacity: 1; }
  .tmdb-note { font-size: var(--font-size-xs) !important; color: var(--color-text-3) !important; }
</style>
