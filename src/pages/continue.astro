---
// src/pages/continue.astro — full "Continue Watching" history.
// The history is stored in localStorage by the players, so the list itself is
// rendered by a client island; the page is noIndex because it is per-visitor.
import Layout from '../layouts/Layout.astro';
import ContinueWatchingGrid from '../components/react/ContinueWatchingGrid';
---

<Layout
  title="Continue Watching"
  description="Pick up every movie and episode you started, right where you left off."
  noIndex
  noExtras
>
  <div class="container cw-page">
    <nav class="cw-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Continue Watching</span>
    </nav>

    <header class="cw-page-header">
      <h1 class="cw-page-title">Continue Watching</h1>
      <p class="cw-page-sub">
        Everything you started, newest first. Kept on this device only.
      </p>
    </header>

    <ContinueWatchingGrid client:only="react" />
  </div>
</Layout>

<style>
  .cw-page {
    padding-top: var(--nav-offset);
    padding-bottom: 4rem;
  }

  .cw-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    color: var(--color-text-3);
    margin-bottom: 1rem;
  }
  .cw-crumbs a { color: var(--color-text-3); text-decoration: none; }
  .cw-crumbs a:hover { color: var(--color-text); }

  .cw-page-header { margin-bottom: 2rem; }

  .cw-page-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: var(--letter-spacing-tight);
    margin: 0 0 0.375rem;
  }

  .cw-page-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-3);
    margin: 0;
  }
</style>
