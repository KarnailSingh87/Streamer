---
// src/pages/404.astro — Not Found
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist."
  noIndex={true}
>
  <div class="err-page container">
    <div class="err-inner">
      <div class="err-code" aria-hidden="true">404</div>
      <h1 class="err-title">This page took an intermission</h1>
      <p class="err-desc">
        The page you're looking for doesn't exist, moved, or never made it past the cutting-room floor.
      </p>
      <div class="err-actions">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/movies" class="btn btn-secondary">Browse Movies</a>
        <a href="/search" class="btn btn-secondary">Search</a>
      </div>

      <div class="err-links">
        <span class="err-links-label">Popular destinations</span>
        <div class="err-links-row">
          <a href="/series">Series</a>
          <a href="/anime">Anime</a>
          <a href="/netflix">Netflix</a>
          <a href="/prime">Prime</a>
          <a href="/watchlist">Watchlist</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .err-page { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 4rem 0; }
  .err-inner { text-align: center; max-width: 560px; }
  .err-code {
    font-size: clamp(6rem, 22vw, 12rem); font-weight: 900; line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 1rem; user-select: none;
  }
  .err-title { font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-text); letter-spacing: -0.02em; margin: 0 0 0.75rem; }
  .err-desc { font-size: var(--font-size-base); color: var(--color-text-2); line-height: 1.6; margin: 0 0 2rem; }
  .err-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .err-links { padding-top: 1.75rem; border-top: 1px solid var(--color-border); }
  .err-links-label { display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-3); margin-bottom: 0.875rem; }
  .err-links-row { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
  .err-links-row a {
    font-size: 0.8125rem; font-weight: 500; color: var(--color-text-2);
    text-decoration: none; padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border); border-radius: 9999px; transition: all 0.15s ease;
  }
  .err-links-row a:hover { color: var(--color-text); border-color: var(--color-accent-from); background: var(--color-surface); }
</style>
