---
// src/pages/search.astro — /search with instant, type-as-you-go results.
//
// The page still server-renders whatever `?q=` asks for (good for SEO and
// shared links), then hands that same payload to the InstantSearch island so
// hydration is seamless. From there every keystroke updates the grid — a
// single letter is enough, and there is no Enter or button to press.
import Layout from '../layouts/Layout.astro';
import InstantSearch from '../components/react/InstantSearch';
import { buildLiveSearch, buildRecommended, normalizeTab } from '../lib/liveSearch';
import type { LiveSearchPayload, RecommendedPayload } from '../lib/liveSearch';

const url = Astro.url;
const q = url.searchParams.get('q')?.trim() ?? '';
const tab = normalizeTab(url.searchParams.get('tab'));

// Only fetch what the first paint needs: results when there is a query,
// trending recommendations when there isn't.
const [initialData, recommended] = await Promise.all([
  q ? buildLiveSearch(q, tab).catch((): LiveSearchPayload | null => null) : Promise.resolve(null),
  buildRecommended().catch((): RecommendedPayload => ({ movies: [], series: [] })),
]);

const POPULAR_QUERIES = [
  'Inception', 'Interstellar', 'Breaking Bad', 'Oppenheimer',
  'Dune', 'The Bear', 'Shogun', 'Fallout', 'Dark', 'Parasite',
];

const TMDB_IMG = 'https://image.tmdb.org/t/p';
const galleryImages: string[] = [
  ...(initialData?.movies ?? []),
  ...(initialData?.series ?? []),
  ...recommended.movies,
  ...recommended.series,
]
  .map((r) => r.backdropPath)
  .filter((p): p is string => Boolean(p))
  .slice(0, 12)
  .map((p) => `${TMDB_IMG}/w780${p}`);

const resultCount = initialData
  ? initialData.movies.length + initialData.series.length + initialData.people.length
  : 0;
---

<Layout
  title={q ? `"${q}" — Search` : 'Search'}
  description={q
    ? `Search results for "${q}" — movies, series and people on Streamer.`
    : 'Search every movie and series. Results appear as you type — one letter is enough.'}
  galleryImages={galleryImages}
>
  <div class="container search-page">
    <header class="search-head">
      <h1 class="search-title">
        {q ? (
          <>Results for <span class="search-title-q">"{q}"</span></>
        ) : (
          <>Find anything to <span class="search-title-q">watch</span></>
        )}
      </h1>
      <p class="search-sub">
        {q && resultCount > 0
          ? `${resultCount.toLocaleString()} matches, ranked by relevance.`
          : 'Start typing a title, an actor, or even a single letter — recommendations appear instantly.'}
      </p>
    </header>

    <InstantSearch
      client:load
      initialQuery={q}
      initialTab={tab}
      initialData={initialData}
      recommended={recommended}
      popularQueries={POPULAR_QUERIES}
    />

    <noscript>
      <p class="search-noscript">
        Instant search needs JavaScript. Browse
        <a href="/movies">movies</a> or <a href="/series">series</a> instead.
      </p>
    </noscript>
  </div>
</Layout>

<style>
  .search-page {
    padding-top: var(--nav-offset);
    padding-bottom: 4rem;
  }

  .search-head {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .search-title {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .search-title-q {
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .search-sub {
    margin: 0;
    max-width: 46rem;
    font-size: var(--font-size-sm);
    line-height: 1.4;
    color: var(--color-text-2);
  }

  .search-noscript {
    margin-top: 2rem;
    color: var(--color-text-2);
  }

  @media (max-width: 767px) {
    .search-page { padding-bottom: 3rem; }
    .search-head { margin-bottom: 0.625rem; gap: 0.125rem; }
    .search-title { font-size: 1.375rem; }
    .search-sub { font-size: var(--font-size-xs); }
  }
</style>
