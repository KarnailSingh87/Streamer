---
// src/pages/netflix.astro — Netflix hub page
import Layout from '../layouts/Layout.astro';
import Top10Rail from '../components/Top10Rail.astro';
import MovieRail from '../components/MovieRail.astro';
import HeroCarousel from '../components/react/HeroCarousel';
import { getPlatformPageData } from '../lib/tmdb';

let pageData: Awaited<ReturnType<typeof getPlatformPageData>> | null = null;
let error: string | null = null;
try {
  pageData = await getPlatformPageData('netflix');
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load';
}

const heroSlides   = pageData?.heroSlides   ?? [];
const top10TV      = pageData?.top10TV      ?? [];
const top10Movies  = pageData?.top10Movies  ?? [];
const popularTV    = pageData?.popularTV    ?? [];
const popularMovies = pageData?.popularMovies ?? [];
---

<Layout title="Netflix — Top 10 & Originals">
  {heroSlides.length > 0 && (
    <HeroCarousel client:load slides={heroSlides} label="Netflix Top 10" />
  )}

  <div class="platform-page">
    <!-- Brand header -->
    <div class="container">
      <div class="platform-brand platform-brand--netflix">
        <div class="platform-logo-wrap">
          <svg width="32" height="46" viewBox="0 0 111 190" fill="none">
            <path d="M0 0h28.6l53.6 143.6V0H111v190l-27.7.1-55-147.6V190H0V0z" fill="#e50914"/>
          </svg>
        </div>
        <div>
          <h1 class="platform-name">Netflix</h1>
          <p class="platform-desc">Top shows, originals &amp; films streaming on Netflix</p>
        </div>
      </div>
    </div>

    <div class="platform-sections">
      {top10TV.length > 0 && (
        <div data-reveal>
          <Top10Rail title="Top 10 Series on Netflix Today" items={top10TV} mediaType="tv" accentColor="#e50914" />
        </div>
      )}
      {top10Movies.length > 0 && (
        <div data-reveal>
          <Top10Rail title="Top 10 Movies on Netflix Today" items={top10Movies} mediaType="movie" accentColor="#e50914" />
        </div>
      )}
      {popularTV.length > 0 && (
        <div data-reveal>
          <MovieRail title="Popular Series" items={popularTV} mediaType="tv" />
        </div>
      )}
      {popularMovies.length > 0 && (
        <div data-reveal>
          <MovieRail title="Popular Movies" items={popularMovies} mediaType="movie" />
        </div>
      )}
      {!error && top10TV.length === 0 && top10Movies.length === 0 && (
        <div class="platform-empty container">
          <p>No Netflix content found for your region right now. Try again later.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .platform-page { padding-bottom: 4rem; }
  .platform-brand {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 2rem 0 1.5rem;
    margin-bottom: 0.5rem;
  }
  .platform-logo-wrap {
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .platform-brand--netflix .platform-logo-wrap { background: #000; border: 1px solid rgba(229,9,20,0.4); }
  .platform-name {
    font-size: var(--font-size-2xl); font-weight: 700;
    color: var(--color-text); margin: 0 0 0.2rem;
    letter-spacing: var(--letter-spacing-tight);
  }
  .platform-desc { font-size: var(--font-size-sm); color: var(--color-text-3); margin: 0; }
  .platform-sections {
    display: flex; flex-direction: column;
    gap: var(--section-gap, 2rem);
    padding-top: 1.5rem;
  }
  .platform-empty { padding: 4rem 0; color: var(--color-text-3); text-align: center; }
</style>
