---
interface Props {
  images?: string[];
}

const { images = [] } = Astro.props;

// Fallback backdrops so the gallery always renders even when a page supplies
// no images (e.g. when the TMDB fetch returns nothing on the home page).
const DEFAULT_IMAGES = [
  'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1440404653325-ab127d49abc1?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1595769816263-9b910be24d5f?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1524712245354-2c4e5e7121c0?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1502136969935-8d8eef54d77b?w=780&auto=format&fit=crop&q=60',
];

const provided = images.filter(Boolean).slice(0, 8);
const visibleImages = provided.length ? provided : DEFAULT_IMAGES;
---

{visibleImages.length > 0 && (
  <section class="cinematic-gallery" aria-labelledby="cinematic-gallery-title" data-reveal>
    <div class="cinematic-gallery-grid" aria-hidden="true">
      {visibleImages.map((src, index) => (
        <img
          src={src}
          alt=""
          width="780"
          height="439"
          loading="lazy"
          decoding="async"
          class={`cinematic-gallery-image cinematic-gallery-image-${index + 1}`}
        />
      ))}
    </div>
    <div class="cinematic-gallery-scrim" aria-hidden="true"></div>
    <div class="cinematic-gallery-copy">
      <span>Explore more</span>
      <h2 id="cinematic-gallery-title">Stories worth discovering</h2>
      <p>Browse new worlds, unforgettable characters, and your next favorite watch.</p>
    </div>
  </section>
)}

<style>
  .cinematic-gallery {
    position: relative;
    min-height: clamp(320px, 50vw, 640px);
    overflow: hidden;
    border-block: 1px solid var(--color-border);
    background: #03050a;
    isolation: isolate;
  }
  .cinematic-gallery-grid {
    position: absolute;
    inset: -5%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: clamp(6px, 1vw, 14px);
    transform: rotate(-2deg) scale(1.04);
  }
  .cinematic-gallery-image {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    opacity: 0.72;
    filter: saturate(0.8) contrast(1.08);
  }
  .cinematic-gallery-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 50% 48%, rgba(3,5,10,0.18), rgba(3,5,10,0.82) 78%),
      linear-gradient(to bottom, rgba(3,5,10,0.45), transparent 28%, transparent 70%, rgba(3,5,10,0.92));
  }
  .cinematic-gallery-copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: #fff;
  }
  .cinematic-gallery-copy span {
    margin-bottom: 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.68);
  }
  .cinematic-gallery-copy h2 {
    max-width: 800px;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
    text-shadow: 0 8px 40px rgba(0,0,0,0.75);
  }
  .cinematic-gallery-copy p {
    max-width: 560px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.72);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
  }
  @media (max-width: 700px) {
    .cinematic-gallery-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(4, 1fr); }
    .cinematic-gallery { min-height: 440px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cinematic-gallery-image { transition: opacity 180ms ease, filter 180ms ease; }
    .cinematic-gallery:hover .cinematic-gallery-image { opacity: 0.82; filter: saturate(1) contrast(1.05); }
  }
</style>
