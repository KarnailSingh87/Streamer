---
// Layout.astro — Base layout for Streamer
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import CinematicFooter from '../components/react/CinematicFooter';
import BackToTop from '../components/react/BackToTop';
import BottomTabBar from '../components/react/BottomTabBar';
import CookieConsent from '../components/react/CookieConsent';
import CinematicGallery from '../components/CinematicGallery.astro';
import FeaturedGallery from '../components/react/FeaturedGallery';
import Testimonials from '../components/react/Testimonials';
import '../styles/global.css';
// Poster card (poster-card-* / pc-*) — shared by PosterCard.astro and the React
// islands (instant search) so both render the exact same card.
import '../styles/poster-card.css';
// Player chrome (fp-*). Loaded after global.css so it can use the colour tokens,
// and before mobile.css so page-level mobile overrides still win.
import '../styles/player.css';
import '../styles/mobile.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  user?: { name: string; avatar_url: string | null } | null;
  noFooter?: boolean;
  noNav?: boolean;
  noIndex?: boolean;
  /** Skip the shared CinematicGallery + Testimonials sections for this page. */
  noExtras?: boolean;
  /** Optional images for the shared CinematicGallery; falls back to a default set. */
  galleryImages?: string[];
}

const {
  title = 'Streamer',
  description = 'Every movie and show, one clean place to find where to watch it.',
  image,
  user = null,
  noFooter = false,
  noNav = false,
  noIndex = false,
  noExtras = true,
  galleryImages = [],
} = Astro.props;

// Default backdrop set for the shared CinematicGallery so it renders on every
// page (desktop + mobile) even when a page doesn't supply its own images.
const DEFAULT_GALLERY_IMAGES = [
  'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1440404653325-ab127d49abc1?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1595769816263-9b910be24d5f?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1524712245354-2c4e5e7121c0?w=780&auto=format&fit=crop&q=60',
  'https://images.unsplash.com/photo-1502136969935-8d8eef54d77b?w=780&auto=format&fit=crop&q=60',
];

const extrasImages = galleryImages.length ? galleryImages : DEFAULT_GALLERY_IMAGES;

const canonical = new URL(Astro.url.pathname, 'https://streamer.duckdns.org').toString();
const ogImage   = image ?? 'https://streamer.duckdns.org/og-default.png';
const pageTitle = title.includes('Streamer') ? title : `${title} — Streamer`;

// Human verification gate is scoped to the home page only. It is rendered
// server-side just for "/"; every other route never includes the gate markup.
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="Streamer" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="streamer" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050811" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://image.tmdb.org" />
    <link rel="preconnect" href="https://api.tmdb.org" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CL6ECGJ4JL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // send_page_view:false — we send page_view manually so Astro view
      // transitions (client-side navigation) are tracked correctly.
      gtag('config', 'G-CL6ECGJ4JL', { send_page_view: false });

      function faSendPageView() {
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: location.href,
          page_path: location.pathname + location.search,
        });
      }
      // Initial load
      faSendPageView();
      // Every Astro view-transition navigation
      document.addEventListener('astro:page-load', faSendPageView);
    </script>

    <ClientRouter />
    <slot name="head" />

    <!-- ── Theme init: runs synchronously before paint to avoid FOUC ── -->
    <script is:inline>
      (function () {
        function applyTheme() {
          const saved = localStorage.getItem('streamer_theme');
          const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', saved || preferred);
        }
        // Run immediately on first load
        applyTheme();
        // Re-apply after every Astro view-transition swap (page navigation)
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

  </head>

  <body>
    <!-- ── Scroll progress bar (pure DOM, no React re-renders) ── -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <!-- ── Navigation progress bar ──
         Instant feedback for internal link clicks. Purely CSS-driven off a
         class on <html>, set synchronously in the astro:before-preparation
         handler, so the bar starts moving in the same frame as the click
         instead of after the new document arrives. -->
    <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>

    <!-- Skip to main -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {!noNav && <Nav user={user} />}

    <slot name="cookie-banner" />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    {/* ── Shared cinematic gallery + testimonials ──
         Rendered on every page (desktop + mobile) except the home page, which
         renders its own pair (so we avoid duplicating them there). Pages can opt
         out via the `noExtras` prop and supply their own images via
         `galleryImages`.

         Order: FeaturedGallery (WebGL) first, then the zero-JavaScript
         CinematicGallery. GalleryShowcase used to sit after both and has been
         removed site-wide — it was a second Three.js canvas rendering the same
         hard-coded demo stills.

         FeaturedGallery is client:visible, not client:only: client:only made
         Astro's view-transition router reload the entire target page in a
         hidden iframe on every navigation (prepareForClientOnlyComponents),
         which was the single largest source of navigation latency. */}
    {!isHome && !noExtras && (
      <>
        <FeaturedGallery client:visible={{ rootMargin: '400px' }} images={extrasImages} />
        <CinematicGallery images={extrasImages} />
        <Testimonials client:visible />
      </>
    )}

    {!noFooter && <CinematicFooter client:visible />}

    <!-- Bottom tab bar (mobile only — hidden via CSS at ≥768px) -->
    <BottomTabBar client:load />

    <!-- Back-to-top (React island) -->
    <BackToTop client:idle threshold={600} />

    <!-- ── Global cookie consent — shown on every page (mobile + desktop) ── -->
    <CookieConsent client:idle />

    <!-- Scroll progress + scroll-reveal scripts -->
    <script>
      // ── Navigation feedback ───────────────────────────────────
      // The delay people feel on a nav click is the gap between the click and
      // the new document being ready to swap. Nothing used to paint in that
      // window, so the UI felt dead. These handlers run synchronously in the
      // click's own task: the progress bar starts within one frame (<16ms) and
      // the clicked link gets a pressed state immediately, well inside the
      // 250ms budget, regardless of how long the document itself takes.
      const rootEl = document.documentElement;

      // Mark the clicked link the moment the pointer goes down — this fires
      // before navigation even begins.
      for (const evt of ['pointerdown', 'keydown'] as const) {
        document.addEventListener(evt, (e) => {
          if (evt === 'keydown' && (e as KeyboardEvent).key !== 'Enter') return;
          const anchor = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
          if (!anchor) return;
          let url: URL;
          try { url = new URL(anchor.href, location.href); } catch { return; }
          if (url.origin !== location.origin) return;
          document.querySelectorAll('.is-navigating').forEach((el) => el.classList.remove('is-navigating'));
          anchor.classList.add('is-navigating');
        }, { passive: true, capture: true });
      }

      document.addEventListener('astro:before-preparation', () => {
        rootEl.classList.remove('nav-done');
        rootEl.classList.add('nav-loading');
      });
      function endNavProgress() {
        rootEl.classList.remove('nav-loading');
        rootEl.classList.add('nav-done');
        document.querySelectorAll('.is-navigating').forEach((el) => el.classList.remove('is-navigating'));
        window.setTimeout(() => rootEl.classList.remove('nav-done'), 260);
      }
      document.addEventListener('astro:after-swap', endNavProgress);
      // If a navigation is cancelled or fails, don't leave the bar stuck.
      window.addEventListener('pagehide', endNavProgress);



      // ── Scroll progress bar ──────────────────────────────────
      const progressBar = document.getElementById('scroll-progress');
      let rafId = 0;
      function updateProgress() {
        const scrollTop  = window.scrollY;
        const docHeight  = document.documentElement.scrollHeight - window.innerHeight;
        const pct        = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) progressBar.style.width = `${pct}%`;
        rafId = 0;
      }
      window.addEventListener('scroll', () => {
        if (rafId) return;
        rafId = requestAnimationFrame(updateProgress);
      }, { passive: true });

      // ── Scroll-reveal (lightweight, zero-dependency) ─────────
      // Any element with [data-reveal] fades/slides in when it enters view.
      function initReveal() {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)'));
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        els.forEach((el) => io.observe(el));
      }
      initReveal();
      // Re-init after Astro view-transition swaps.
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

<style>
  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    background: #6366f1;
    color: #fff;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 8px 0;
    z-index: calc(var(--z-nav) + 10);
    transition: top 0.2s ease;
  }
  .skip-link:focus { top: 0; }

  /* ── Navigation progress bar ──
     Driven entirely by a class on <html> so it can start in the same frame as
     the click. The first 90% is an eased "optimistic" fill (we don't know how
     long the document will take); astro:after-swap snaps it to 100% and fades
     it out. */
  .nav-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, #6366f1, #a855f7);
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.7);
    z-index: calc(var(--z-nav) + 20);
    opacity: 0;
    pointer-events: none;
    border-radius: 0 2px 2px 0;
  }
  :global(html.nav-loading) .nav-progress {
    opacity: 1;
    width: 90%;
    transition: width 8s cubic-bezier(0.1, 0.7, 0.1, 1), opacity 0.1s linear;
  }
  :global(html.nav-done) .nav-progress {
    opacity: 0;
    width: 100%;
    transition: width 0.12s ease-out, opacity 0.25s ease-out 0.1s;
  }

  /* Pressed state for the link being navigated to — applied on pointerdown,
     before navigation starts, so the tap always registers visually. */
  :global(a.is-navigating) {
    opacity: 0.62;
    transition: opacity 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.nav-loading) .nav-progress,
    :global(html.nav-done) .nav-progress { transition: none; }
  }

  main { min-height: calc(100vh - 56px); }
</style>
