{
  "name": "streamer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:nohmr": "NO_HMR=1 astro dev",
    "build": "astro build",
    "build:vercel": "DEPLOY_TARGET=vercel astro build",
    "build:render": "DEPLOY_TARGET=node astro build",
    "build:node": "DEPLOY_TARGET=node astro build",
    "start": "node ./dist/server/entry.mjs",
    "db:init": "node scripts/init-db.mjs",
    "preview": "astro preview",
    "minify:server": "node scripts/minify-server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "deploy": "astro build && node scripts/minify-server.mjs && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.1",
    "@astrojs/vercel": "^11.0.4",
    "@libsql/client": "^0.17.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "arctic": "^3.7.0",
    "astro": "^7.1.1",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "hls.js": "1.6.16",
    "lucia": "^3.2.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "oslo": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
